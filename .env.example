# ---------------------------------------------------------------------------
# SOC-Lite · configuración de ejemplo
# Copie este archivo a .env y cambie todos los secretos antes de desplegar.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=genera-una-clave-aleatoria-de-64-caracteres-con-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DEMO_MODE=true
AUTO_SEED=true

# PostgreSQL (el host "db" aplica dentro de docker compose)
POSTGRES_DB=soc_lite
POSTGRES_USER=soc_lite
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=cambia-esta-password
DATABASE_URL=postgresql+psycopg://soc_lite:cambia-esta-password@db:5432/soc_lite

# Ingesta n8n / Wazuh / OPNsense
INGEST_API_KEY=dev-ingest-key-cambiar

# Microservicio de triaje
TRIAGE_SERVICE_URL=http://ai-service:8001
TRIAGE_API_KEY=clave-interna-ai-cambiar
TRIAGE_MODE=auto
TRIAGE_TIMEOUT_SECONDS=60

# n8n (Docker Compose). Use valores aleatorios y conserve N8N_ENCRYPTION_KEY.
N8N_VERSION=1.111.1
N8N_DB_PASSWORD=cambia-esta-password-n8n
N8N_ENCRYPTION_KEY=genera-una-clave-aleatoria-de-64-caracteres-para-n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
TIMEZONE=America/Lima

# osTicket opcional: se usa con docker-compose.osticket.yml.
OSTICKET_HOST_PORT=8088
OSTICKET_DB_PASSWORD=cambia-esta-password-osticket-db
OSTICKET_SECRET_SALT=genera-una-clave-aleatoria-de-32-caracteres
OSTICKET_ADMIN_EMAIL=admin@example.org
OSTICKET_ADMIN_PASSWORD=cambia-esta-password-admin-osticket
OSTICKET_REQUESTER_EMAIL=soc-lite@example.org

# LLM local (Ollama) u OpenAI opcional
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enriquecimiento externo (opcional, desactivado por defecto por privacidad)
ENRICHMENT_ENABLED=true
GEOIP_ENABLED=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# CORS: origen del frontend
FRONTEND_HOST_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
